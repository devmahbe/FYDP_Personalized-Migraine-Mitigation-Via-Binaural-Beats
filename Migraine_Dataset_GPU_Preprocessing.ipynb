    "## 5. Helper Functions for EEG Cleaning\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "2fe85475",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
