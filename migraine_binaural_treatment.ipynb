            "source": [
                "import torch\n",
                "import torch.nn as nn\n",
                "import torch.optim as optim\n",
                "from torch.utils.data import TensorDataset, DataLoader\n",
                "from sklearn.metrics import confusion_matrix, classification_report\n",
                "from sklearn.preprocessing import StandardScaler\n",
                "\n",
                "class MigraineDNN(nn.Module):\n",
                "    \"\"\"Deep Neural Network for EEG-based migraine classification\"\"\"\n",
                "    def __init__(self, input_features=1738, num_classes=3):\n",
                "        super().__init__()\n",
                "        self.fc1 = nn.Linear(input_features, 512)\n",
                "        self.bn1 = nn.BatchNorm1d(512)\n",
                "        self.dropout1 = nn.Dropout(0.4)\n",
                "        \n",
                "        self.fc2 = nn.Linear(512, 256)\n",
                "        self.bn2 = nn.BatchNorm1d(256)\n",
                "        self.dropout2 = nn.Dropout(0.3)\n",
                "        \n",
                "        self.fc3 = nn.Linear(256, 128)\n",
                "        self.bn3 = nn.BatchNorm1d(128)\n",
                "        self.dropout3 = nn.Dropout(0.2)\n",
                "        \n",
                "        self.fc4 = nn.Linear(128, 64)\n",
                "        self.bn4 = nn.BatchNorm1d(64)\n",
                "        \n",
                "        self.fc5 = nn.Linear(64, num_classes)\n",
                "        \n",
                "    def forward(self, x):\n",
                "        x = torch.relu(self.bn1(self.fc1(x)))\n",
                "        x = self.dropout1(x)\n",
                "        x = torch.relu(self.bn2(self.fc2(x)))\n",
                "        x = self.dropout2(x)\n",
                "        x = torch.relu(self.bn3(self.fc3(x)))\n",
                "        x = self.dropout3(x)\n",
                "        x = torch.relu(self.bn4(self.fc4(x)))\n",
                "        return self.fc5(x)\n",
                "\n",
                "# ===== FIX: Clean data before normalization =====\n",
                "print(\"Cleaning and normalizing features...\")\n",
                "\n",
                "# Step 1: Handle NaN and Inf values\n",
                "X_train_clean = X_train.copy()\n",
                "X_test_clean = X_test.copy()\n",
                "\n",
                "# Replace NaN with column median (or 0 if all NaN)\n",
                "for col in range(X_train_clean.shape[1]):\n",
                "    col_data = X_train_clean[:, col]\n",
                "    if np.isnan(col_data).any():\n",
                "        median_val = np.nanmedian(col_data)\n",
                "        if np.isnan(median_val):\n",
                "            median_val = 0.0\n",
                "        X_train_clean[np.isnan(X_train_clean[:, col]), col] = median_val\n",
                "        X_test_clean[np.isnan(X_test_clean[:, col]), col] = median_val\n",
                "\n",
                "# Replace Inf with large finite values\n",
                "X_train_clean = np.nan_to_num(X_train_clean, nan=0.0, posinf=1e10, neginf=-1e10)\n",
                "X_test_clean = np.nan_to_num(X_test_clean, nan=0.0, posinf=1e10, neginf=-1e10)\n",
                "\n",
                "print(f\"After cleaning:\")\n",
                "print(f\"  NaN values: {np.isnan(X_train_clean).sum()}\")\n",
                "print(f\"  Inf values: {np.isinf(X_train_clean).sum()}\")\n",
                "\n",
                "# Step 2: Normalize with StandardScaler\n",
                "scaler = StandardScaler()\n",
                "X_train_scaled = scaler.fit_transform(X_train_clean)\n",
                "X_test_scaled = scaler.transform(X_test_clean)\n",
                "\n",
                "# Convert to PyTorch tensors\n",
                "X_train_tensor = torch.FloatTensor(X_train_scaled)\n",
                "y_train_tensor = torch.LongTensor(y_train)\n",
                "X_test_tensor = torch.FloatTensor(X_test_scaled)\n",
                "y_test_tensor = torch.LongTensor(y_test)\n",
                "\n",
                "print(f\"\\nFeature stats after normalization:\")\n",
                "print(f\"  Mean: {X_train_scaled.mean():.6f}\")\n",
                "print(f\"  Std: {X_train_scaled.std():.6f}\")\n",
                "print(f\"  Min: {X_train_scaled.min():.6f}\")\n",
                "print(f\"  Max: {X_train_scaled.max():.6f}\")\n",
                "\n",
                "# Verify no NaN in tensors\n",
                "if torch.isnan(X_train_tensor).any():\n",
                "    print(\"\\n⚠️ WARNING: NaN detected in training tensor after preprocessing!\")\n",
                "    print(\"   Replacing with zeros...\")\n",
                "    X_train_tensor = torch.nan_to_num(X_train_tensor, nan=0.0)\n",
                "    X_test_tensor = torch.nan_to_num(X_test_tensor, nan=0.0)\n",
                "\n",
                "# Setup training\n",
                "device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
                "print(f\"\\nTraining on: {device}\")\n",
                "\n",
                "model_nn = MigraineDNN(input_features=X_train.shape[1]).to(device)\n",
                "criterion = nn.CrossEntropyLoss()\n",
                "optimizer = optim.Adam(model_nn.parameters(), lr=0.0005, weight_decay=1e-5)\n",
                "\n",
                "# Training configuration\n",
                "epochs = 100\n",
                "batch_size = 8\n",
                "\n",
                "train_dataset = TensorDataset(X_train_tensor, y_train_tensor)\n",
                "train_loader = DataLoader(train_dataset, batch_size=batch_size, shuffle=True)\n",
                "\n",
                "# Training loop\n",
                "print(\"\\nTraining Neural Network Classifier...\")\n",
                "print(\"=\" * 60)\n",
                "\n",
                "train_losses = []\n",
                "for epoch in range(epochs):\n",
                "    model_nn.train()\n",
                "    total_loss = 0\n",
                "    correct = 0\n",
                "    total = 0\n",
                "    \n",
                "    for X_batch, y_batch in train_loader:\n",
                "        X_batch, y_batch = X_batch.to(device), y_batch.to(device)\n",
                "        \n",
                "        optimizer.zero_grad()\n",
                "        outputs = model_nn(X_batch)\n",
                "        loss = criterion(outputs, y_batch)\n",
                "        \n",
                "        # Check for NaN loss\n",
                "        if torch.isnan(loss):\n",
                "            print(f\"WARNING: NaN loss detected at epoch {epoch+1}\")\n",
                "            print(f\"  Batch stats: min={X_batch.min():.4f}, max={X_batch.max():.4f}\")\n",
                "            break\n",
                "            \n",
                "        loss.backward()\n",
                "        \n",
                "        # Gradient clipping for stability\n",
                "        torch.nn.utils.clip_grad_norm_(model_nn.parameters(), max_norm=1.0)\n",
                "        \n",
                "        optimizer.step()\n",
                "        \n",
                "        total_loss += loss.item()\n",
                "        _, predicted = torch.max(outputs.data, 1)\n",
                "        total += y_batch.size(0)\n",
                "        correct += (predicted == y_batch).sum().item()\n",
                "    \n",
                "    avg_loss = total_loss / len(train_loader)\n",
                "    train_acc = 100 * correct / total\n",
                "    train_losses.append(avg_loss)\n",
                "    \n",
                "    if (epoch + 1) % 10 == 0:\n",
                "        print(f\"Epoch {epoch+1:3d}/{epochs} | Loss: {avg_loss:.4f} | Train Acc: {train_acc:.2f}%\")\n",
                "\n",
                "print(\"\\n\" + \"=\" * 60)"
            ]
        },
