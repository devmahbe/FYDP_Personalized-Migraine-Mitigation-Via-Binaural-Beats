                "        val_acc = 100 * (val_predicted == y_val_tensor).float().mean().item()\n",
                "        \n",
                "    val_losses_cnn_lstm.append(val_loss.item())\n",
                "    val_accs_cnn_lstm.append(val_acc)\n",
                "    \n",
                "    # Learning rate scheduling\n",
                "    scheduler.step(val_loss)\n",
